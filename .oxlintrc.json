{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "typescript/no-explicit-any": "error",
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "eqeqeq": "error",
    "prefer-const": "error",
    "no-var": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "no-else-return": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "test-results",
    "playwright-report",
    "coverage",
    "scripts"
  ]
}
